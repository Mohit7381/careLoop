# Copy to .env and fill in before Day 2 (live calls). Everything works
# in demo_mode=true without any of this.

APP_TOKEN=dev-local-token
DEMO_MODE=true

DATABASE_URL=sqlite:///./careloop.db
ARTIFACTS_DIR=./data/artifacts

# sphere-platform LLM gateway
SPHERE_PLATFORM_BASE_URL=
SPHERE_PLATFORM_API_KEY=

# Metabase (read-only, Redshift DB 39) — Alief's Fetcher
METABASE_BASE_URL=
METABASE_API_KEY=

# GitLab read-only PAT — Harshit's Code Scout. Self-hosted, NOT gitlab.com.
GITLAB_BASE_URL=https://gitlab.devops.mhealth.tech
GITLAB_READ_TOKEN=

# Garuda delivery — real API verified 2026-09-03 (see app/integrations/garuda_client.py).
# channel_id/provider_id/template_id must be pre-provisioned in Garuda itself — there is no
# self-service registration. Get real values from whoever owns Garuda (same blocker Harshit
# flagged in chat: webhook not received yet, SRE not fully aware). Also unconfirmed: whether
# GChat is even a supported Garuda channel type — every verified example is WhatsApp/SMS/Email.
GARUDA_BASE_URL=
GARUDA_APP_TOKEN=
GARUDA_CHANNEL_ID=
GARUDA_PROVIDER_ID=
GARUDA_TEMPLATE_ID=
GARUDA_DESTINATION=
GARUDA_SERVICE_SOURCE=careloop-service
